# Copy this file to .env.local and fill in both values to use Supabase.
# Leave them empty (or don't create .env.local) to run in browser demo mode.
#
# Find them in Supabase: Project Settings → API Keys (and Data API for the URL).
# Use the PUBLISHABLE key (starts with sb_publishable_) or the legacy "anon" key.
# NEVER put the secret / service_role key here — NEXT_PUBLIC_ values are sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
